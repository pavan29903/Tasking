# Copy to frontend/.env and fill in. Read at build time (npm run build).

# Where the API lives. Leave empty when the API serves this web app (one server, recommended).
# Set it for a bundled APK or a separately hosted frontend, e.g. https://api.YOUR-TASKING-DOMAIN.example
VITE_API_URL=

# Public address used in invite links. Empty = the address the page was opened from.
VITE_APP_URL=

# Android shell (read by capacitor.config.ts when you run `npx cap sync`, not by Vite):
#   TASKING_APP_URL=https://YOUR-TASKING-DOMAIN.example   -> the APK opens your hosted site
#   TASKING_APP_ID=com.yourcompany.tasking               -> unique id for the Play Store
