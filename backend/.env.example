# Copy to backend/.env and fill in. Real environment variables override this file.

# Local default is a SQLite file (backend/tasking.db). For production use Postgres:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-DB-HOST:5432/tasking
#   (and run: uv add "psycopg[binary]")
DATABASE_URL=

# REQUIRED in production: 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production  (production refuses to start without a strong SECRET_KEY)
APP_ENV=development

# Public address of the web app, e.g. https://YOUR-TASKING-DOMAIN.example
APP_URL=https://YOUR-TASKING-DOMAIN.example

# Browsers allowed to call the API from another origin (comma separated).
# Not needed when the API serves the web app itself (same origin).
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# How long a sign-in lasts, in hours (default 14 days)
TOKEN_HOURS=336
